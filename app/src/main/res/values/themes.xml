<resources>

    <style name="Theme.KinetiFrame" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_carmine</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/brand_carmine</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:windowBackground">@color/brand_window_background</item>
        <item name="android:colorBackground">@color/brand_window_background</item>
        <item name="android:textColorPrimary">@color/brand_on_window</item>
    </style>
    <!-- The mark sits on a paper disc, like the launcher tile, over the window colour, so the
         splash doesn't flash white in the dark theme. -->
    <style name="Theme.KinetiFrame.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/brand_window_background</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand_paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.KinetiFrame</item>
        <item name="android:windowLightStatusBar">@bool/brand_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/brand_light_system_bars</item>
    </style>
</resources>
