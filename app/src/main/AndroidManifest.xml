<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- In-app voice-over/audio recording for the timeline audio tracks (see AudioManager). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Legacy public-storage write for "Save to Gallery" on video export - only needed below
         Android 10 (API 29): Scoped Storage on 29+ lets a MediaStore insert succeed with no
         storage permission at all, so this is capped with maxSdkVersion and paired with a runtime
         request gated on Build.VERSION.SDK_INT < 29 in ExportRoute (see ProjectExporter). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:name=".KinetiFrameApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KinetiFrame">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.KinetiFrame.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mints content:// URIs for exported .kframe files so they can be shared cross-app
             (Intent.ACTION_SEND) - raw file:// URIs are blocked for that on modern Android.
             Exposes only files-dir/kframe-exports/, not the whole app-private storage area. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
