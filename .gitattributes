# Store text files with LF line endings in the repository.
* text=auto

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary formats: never diff or normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.ogg binary
*.ttf binary
*.otf binary
*.zip binary
*.jar binary
*.kframe binary
*.kpack binary
